# Copy this file to .env (and never commit the real .env) or export
# these directly in your deployment environment / process manager.

# --- EZVIZ cloud account (used by ezviz_cloud_monitor.py) ---
EZVIZ_USERNAME=your_ezviz_account_email
EZVIZ_PASSWORD=your_ezviz_account_password
EZVIZ_REGION=apiisgp.ezvizlife.com

# --- Telegram bot (used by both pipelines) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_or_group_id
